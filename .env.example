# --- Puerto exterior de Docker ---
PORT=7892

# --- MongoDB (en VPS usar host.docker.internal para hablar con el host de Linux) ---
MONGO_URI=mongodb://actualizador:tuPasswordSegura@host.docker.internal:27018/actualizaciones?authSource=admin
MONGO_DB=actualizaciones
FILES_COLLECTION=files_metadata
VERSIONS_COLLECTION=versions
ADMINS_COLLECTION=admins

# --- Carpeta física raíz en el servidor host ---
HOST_ARCHIVOS_DIR=/var/www/archivosACT
HOST_APPS_DIR=/var/www/archivosACT/aplicaciones
HOST_TARIFAS_DIR=/var/www/archivosACT/tarifas
HOST_INDICES_DIR=/var/www/archivosACT/INDICES

# --- Rutas internas del contenedor ---
APPS_DIR=/data/archivosACT/aplicaciones
TARIFAS_DIR=/data/archivosACT/tarifas
INDICES_DIR=/data/archivosACT/INDICES

# --- Sesión ---
SESSION_SECRET=praetor_super_secret_actualitodo_jwt_key_2026_secure
COOKIE_SECURE=false
