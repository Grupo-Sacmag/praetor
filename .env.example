# --- MongoDB (misma instancia que usa Actualitodo) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=envarchdb
# Colección de tarifas/índices (la que lee Actualitodo)
FILES_COLLECTION=files_metadata
# Colección que lee la API /api/versions/{app}  (VERIFICAR el nombre real)
VERSIONS_COLLECTION=versions
# Colección de administradores del portal
ADMINS_COLLECTION=admins

# --- Almacenamiento físico ---
# EXE: se guardan en APPS_DIR/<folder>/<exe>  (debe coincidir con lo que sirve /api/versions/{app}/download)
APPS_DIR=./uploads/apps
# Tarifas e índices: se guardan en TARIFAS_DIR/<fileName>
TARIFAS_DIR=./uploads/envArch
# Opcional: ruta que se escribe en "filePath" de Mongo si difiere de la ruta real
# dentro del contenedor (ej. la ruta que ve Actualitodo). Si se omite, usa TARIFAS_DIR.
TARIFAS_DB_PATH=

# --- Sesión ---
# Generar con: openssl rand -base64 48
SESSION_SECRET=cambia-esto-por-un-secreto-largo
# "true" solo si el portal se sirve por HTTPS (con HTTP plano, dejar en false)
COOKIE_SECURE=false
