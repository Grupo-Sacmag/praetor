# --- Puerto exterior de Docker ---
PORT=7892

# --- MongoDB (en VPS usar host.docker.internal para hablar con el host de Linux) ---
# Si tiene credenciales: mongodb://usuario:password@host.docker.internal:27017/envarchdb?authSource=admin
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB=envarchdb
FILES_COLLECTION=files_metadata
VERSIONS_COLLECTION=versions
ADMINS_COLLECTION=admins

# --- Rutas en el host del servidor (para los volúmenes del docker-compose) ---
HOST_APPS_DIR=/var/www/actualiTodo/version
HOST_TARIFAS_DIR=/var/www/G.A.C/envArch/uploads

# --- Rutas internas del contenedor ---
APPS_DIR=/data/apps
TARIFAS_DIR=/data/envArch
# Ruta que se registra en "filePath" de MongoDB (ruta absoluta que ve la API del servidor)
TARIFAS_DB_PATH=/var/www/G.A.C/envArch/uploads

# --- Sesión ---
# Generar un secreto seguro (mínimo 24 caracteres)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-seguro
# "true" solo si el portal se sirve por HTTPS con dominio/SSL; si entras directo por IP:7892, dejar en false
COOKIE_SECURE=false
